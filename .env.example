# این فایل رو کپی کن به یه فایل جدید به اسم .env (دقیقاً همین پهلو، بدون .example)
# و مقدار DATABASE_URL رو با چیزی که Neon بهت داده جایگزین کن.
# فایل .env هیچ‌وقت نباید وارد GitHub بشه (توی .gitignore هست، نگران نباش).

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=3000
